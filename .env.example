# Use the Java major version required by your downloaded Forge SERVER pack.
# Common requirements are 8, 17, or 21; Java runs inside Docker.
JAVA_VERSION=17
# The pack's Bash startup script, relative to data/ (quote paths with spaces).
SERVER_START_SCRIPT=run.sh
# Host port; keep the pack's server.properties server-port at 25565.
SERVER_PORT=25565
TZ=UTC
# Read https://aka.ms/MinecraftEULA then set true only if you agree.
EULA=false
# Give each copy its own name if running multiple servers on this machine.
COMPOSE_PROJECT_NAME=minecraft-forge-server
