# Match these versions to your downloaded Forge SERVER pack.
MC_VERSION=1.20.1
FORGE_VERSION=47.1.0
# Use 8, 17, or 21 as required by the pack (not your host Java installation).
JAVA_VERSION=17
MEMORY=4G
SERVER_PORT=25565
TZ=UTC
# Read https://aka.ms/MinecraftEULA then set true only if you agree.
EULA=false
# Give each copy its own name if running multiple servers on this machine.
COMPOSE_PROJECT_NAME=minecraft-forge-server
